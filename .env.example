NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
INGEST_TOKEN=
LOG_RETENTION_DAYS=14
DATABASE_URL=postgresql://dolshoe:dolshoe@localhost:5432/dolshoe?schema=public

# Optional: pin the host port `docker compose up` publishes the web dev
# server on. Leave unset (default) to let Docker allocate a free loopback
# port; discover it with `docker compose port web 5173`.
# DOLSHOE_WEB_PORT=5173
