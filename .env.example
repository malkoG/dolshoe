NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
INGEST_TOKEN=
LOG_RETENTION_DAYS=14
SPAN_RETENTION_DAYS=7

# Optional: whether the session cookie is marked Secure. Defaults to on when
# NODE_ENV is production. Set it to false for an instance that legitimately
# serves production traffic over plain HTTP on a private network — a Secure
# cookie there makes signing in fail with nothing to show why.
# SESSION_COOKIE_SECURE=true

# GitHub is the only way to sign in. Register an OAuth app under GitHub's
# Settings > Developer settings > OAuth Apps, then fill in all three of these
# together — a partial set is refused at startup, because the alternative is a
# redirect that fails much later with nothing useful to say. Left empty, as they
# ship, the API still starts and warns, and the sign-in page tells anyone who
# reaches it that nobody can sign in yet.
#
# Walkthrough: docs/github-sign-in.md
#
# The callback URL is your web origin plus /api/v1/auth/github/callback, and has
# to match what GitHub has registered exactly. It is the address a browser
# reaches, which is the web app's origin — not the API's, which is deliberately
# kept off the host network. Locally that means
# http://localhost:5173/api/v1/auth/github/callback with DOLSHOE_WEB_PORT pinned
# at the bottom of this file; left unpinned, Docker picks a different web port on
# every run and no single callback URL can keep matching it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Optional: GitHub logins allowed to hold an account here, comma-separated.
# Empty means no restriction. This gates signing in at all; invitations are what
# decide which organizations an account then reaches. Worth setting before the
# instance is reachable, because an unclaimed instance is claimed by whichever
# allowed account signs in first.
# GITHUB_ALLOWED_LOGINS=octocat,malkoG

# Optional, development only: sign in by typing a login, with no OAuth app and no
# round trip to github.com. Turn it on and the sign-in page grows a field; type
# `dev` and you are that account. Everything past the identity is the real
# sign-in path, so the allowlist above still applies, the first login still
# claims the instance, and everyone after it still needs an invitation.
#
# It is an open door — anyone who can reach the instance can sign in as anybody —
# so an instance with NODE_ENV=production and this set refuses to start rather
# than serving traffic with it on.
# MOCK_LOGIN=true

DATABASE_URL=postgresql://dolshoe:dolshoe@localhost:5432/dolshoe?schema=public

# Where the web app's server-side render reaches the API. Unlike VITE_ variables
# this is never inlined into the browser bundle, which matters because the
# address is usually only reachable from inside the deployment.
DOLSHOE_API_ORIGIN=http://localhost:3000

# Optional: pin the host port `docker compose up` publishes the web dev
# server on. Leave unset (default) to let Docker allocate a free loopback
# port; discover it with `docker compose port web 5173`.
#
# Pin it if you are setting up GitHub sign-in: GITHUB_CALLBACK_URL names a port,
# and a port that moves between runs stops matching what GitHub has registered.
# DOLSHOE_WEB_PORT=5173
