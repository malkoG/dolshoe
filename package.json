{
  "name": "dolshoe",
  "version": "0.0.0",
  "private": true,
  "description": "A simple, self-hosted error reporting and stack tracing service.",
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm db:generate",
    "build": "pnpm sdk:build && pnpm --filter @dolshoe/api build && pnpm --filter @dolshoe/web build",
    "sdk:build": "pnpm --filter './packages/*' -r build",
    "sdk:test:runtimes": "pnpm sdk:build && pnpm --filter @dolshoe/example-logtape-runtimes verify",
    "start": "pnpm --filter @dolshoe/api start",
    "start:prod": "pnpm --filter @dolshoe/api start:prod",
    "dev": "pnpm --filter @dolshoe/api dev",
    "dev:web": "pnpm --filter @dolshoe/web dev",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm sdk:build && pnpm --filter './packages/*' -r typecheck && pnpm --filter @dolshoe/api typecheck && pnpm --filter @dolshoe/web typecheck",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @dolshoe/api test:unit && pnpm --filter @dolshoe/core test:unit && pnpm --filter @dolshoe/node test:unit && pnpm --filter @dolshoe/logtape test:unit && pnpm sdk:test:runtimes",
    "test:watch": "pnpm --filter @dolshoe/api test:watch",
    "test:coverage": "pnpm --filter @dolshoe/api test:coverage",
    "test:e2e": "pnpm db:test:up && pnpm db:test:migrate && pnpm test:e2e:run",
    "test:e2e:run": "dotenv -e .env.test -o -- pnpm --filter @dolshoe/api test:e2e",
    "test:e2e:cold": "pnpm db:test:down && pnpm test:e2e",
    "db:generate": "pnpm --filter @dolshoe/api db:generate",
    "db:validate": "pnpm --filter @dolshoe/api db:validate",
    "db:format": "pnpm --filter @dolshoe/api db:format",
    "db:push": "pnpm --filter @dolshoe/api db:push",
    "db:pull": "pnpm --filter @dolshoe/api db:pull",
    "db:migrate": "pnpm --filter @dolshoe/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @dolshoe/api db:migrate:deploy",
    "db:seed": "pnpm --filter @dolshoe/api db:seed",
    "db:studio": "pnpm --filter @dolshoe/api db:studio",
    "db:reset": "pnpm --filter @dolshoe/api db:reset",
    "db:test:up": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yaml down --remove-orphans",
    "db:test:logs": "docker compose -f compose.test.yaml logs -f postgres-test",
    "db:test:migrate": "dotenv -e .env.test -o -- pnpm --filter @dolshoe/api db:migrate:deploy",
    "db:test:reset": "dotenv -e .env.test -o -- pnpm --filter @dolshoe/api db:reset:force",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down --remove-orphans",
    "docker:logs": "docker compose logs -f postgres",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "check:ci": "pnpm check && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.17.0"
}
