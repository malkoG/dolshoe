NODE_ENV=test
PORT=3000
LOG_LEVEL=warning
DATABASE_URL=postgresql://dolshoe_test:dolshoe_test@localhost:5433/dolshoe_test?schema=public
# Pinned off, and pinned here rather than left unset. The application loads the
# repository's own `.env` too, and a variable this file does not name is one a
# developer's `.env` still decides — so a machine with the sign-in mock turned on
# would otherwise run a different test suite from everybody else's.
MOCK_LOGIN=false
