{
  "name": "@dolshoe/api",
  "version": "0.0.0",
  "private": true,
  "description": "Dolshoe HTTP API",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "dev": "pnpm db:generate && nest start --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "dotenv -e ../../.env.test -o -- jest --config jest.config.cjs",
    "test:watch": "dotenv -e ../../.env.test -o -- jest --config jest.config.cjs --watch",
    "test:coverage": "dotenv -e ../../.env.test -o -- jest --config jest.config.cjs --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:format": "prisma format --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:pull": "prisma db pull --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "db:reset": "prisma migrate reset --config prisma.config.ts",
    "db:reset:force": "prisma migrate reset --force --config prisma.config.ts"
  },
  "dependencies": {
    "@logtape/logtape": "^2.2.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.4.2",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
