generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

/// The tenant. Owns projects, and through them every event reported into them.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  projects    Project[]
  memberships Membership[]
  invitations Invitation[]

  @@index([createdAt(sort: Desc)])
}

/// A person who signs in to read what Dolshoe has recorded. Distinct from a
/// ProjectToken, which authenticates a machine writing into it.
///
/// GitHub is the only way in, so `githubUserId` is what an account is really
/// identified by. It is nullable only to hold accounts created before GitHub
/// sign-in existed: such a row cannot be signed into, and is adopted by the
/// first GitHub account whose address matches. `email` is display and adoption
/// data, never a credential.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  name         String   @db.VarChar(200)
  /// GitHub's immutable numeric account id, as text. Matched on instead of the
  /// login, which its owner can change or give up to somebody else.
  githubUserId String?  @unique @db.VarChar(32)
  /// Stored lowercase. GitHub caps a login at 39 characters.
  githubLogin  String?  @db.VarChar(39)
  avatarUrl    String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  sessions        Session[]
  memberships     Membership[]
  sentInvitations Invitation[] @relation("InvitedBy")

  @@index([githubLogin])
  @@index([createdAt(sort: Desc)])
}

/// What a user may do in an organization. Cascades from both sides: a link has
/// no meaning once either end is gone.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  prefix     String   @unique @db.VarChar(12)
  tokenHash  String   @db.Char(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// An offer to join an organization, carried by a one-time link. Only the
/// digest of that link's token is stored, the same way an ingestion token is.
///
/// Issued against a GitHub login rather than an address, because a GitHub login
/// is the identity the invitee will actually arrive with. The login is resolved
/// to a `githubUserId` when the link is redeemed, so a handle that changes hands
/// between issue and acceptance cannot be used to claim somebody else's seat.
model Invitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// Stored lowercase, so a link issued for "Octocat" is redeemable by
  /// "octocat" — GitHub treats the two as one account.
  githubLogin    String         @db.VarChar(39)
  role           MembershipRole
  prefix         String         @unique @db.VarChar(12)
  tokenHash      String         @db.Char(64)
  invitedById    String         @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime       @db.Timestamptz(3)
  acceptedAt     DateTime?      @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  slug           String   @db.VarChar(100)
  name           String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokens       ProjectToken[]
  errorReports ErrorReport[]
  logRecords   LogRecord[]
  spans        Span[]

  /// A slug only has to be unique inside the organization that owns it: two
  /// tenants both wanting "checkout-api" is the normal case, not a conflict.
  @@unique([organizationId, slug])
  @@index([organizationId, createdAt(sort: Desc)])
}

model ProjectToken {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  name       String    @db.VarChar(200)
  prefix     String    @unique @db.VarChar(12)
  tokenHash  String    @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}

model ErrorReport {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  eventId         String   @db.Uuid
  schemaVersion   Int
  occurredAt      DateTime @db.Timestamptz(3)
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
  serviceName     String   @db.VarChar(200)
  environment     String?  @db.VarChar(100)
  release         String?  @db.VarChar(200)
  runtimeName     String   @db.VarChar(100)
  runtimeVersion  String?  @db.VarChar(100)
  reporterName    String   @db.VarChar(200)
  reporterVersion String?  @db.VarChar(100)
  mechanismType   String?  @db.VarChar(200)
  handled         Boolean?
  traceId         String?  @db.Char(32)
  spanId          String?  @db.Char(16)
  exception       Json
  attributes      Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, eventId])
  @@index([serviceName, occurredAt(sort: Desc)])
  @@index([traceId])
  @@index([receivedAt(sort: Desc)])
  @@index([projectId, receivedAt(sort: Desc)])
}

model LogRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @db.Uuid
  eventId            String   @db.Uuid
  schemaVersion      Int
  occurredAt         DateTime @db.Timestamptz(3)
  receivedAt         DateTime @default(now()) @db.Timestamptz(3)
  level              String   @db.VarChar(10)
  message            String   @db.Text
  category           String[]
  serviceName        String   @db.VarChar(200)
  environment        String?  @db.VarChar(100)
  release            String?  @db.VarChar(200)
  runtimeName        String   @db.VarChar(100)
  runtimeVersion     String?  @db.VarChar(100)
  reporterName       String   @db.VarChar(200)
  reporterVersion    String?  @db.VarChar(100)
  traceId            String?  @db.Char(32)
  spanId             String?  @db.Char(16)
  errorReportEventId String?  @db.Uuid
  attributes         Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, eventId])
  @@index([serviceName, occurredAt(sort: Desc)])
  @@index([level, occurredAt(sort: Desc)])
  @@index([traceId])
  @@index([receivedAt(sort: Desc)])
  @@index([projectId])
}

/// One operation inside a distributed trace, ingested as OTLP/HTTP JSON.
///
/// A trace is a tree, not a list: `parentSpanId` names the enclosing span in the
/// same trace and is null for the root. The parent is kept as a raw span id
/// rather than a foreign key because children routinely arrive before their
/// parent — a server span is only exported once it ends, after every child it
/// created — so a referential constraint would reject valid data.
model Span {
  id           String  @id @default(uuid()) @db.Uuid
  projectId    String  @db.Uuid
  /// Lowercase hex, normalized on ingest. OTLP/JSON permits hex (its own
  /// encoding) and base64 (what a stock protojson emitter produces) for these
  /// byte fields; keeping both would leave one trace unfindable under the other.
  traceId      String  @db.Char(32)
  spanId       String  @db.Char(16)
  parentSpanId String? @db.Char(16)

  name          String  @db.VarChar(500)
  /// "internal" | "server" | "client" | "producer" | "consumer". OTLP's numeric
  /// enum is decoded on ingest so a query reads as the domain word. A plain
  /// VarChar rather than an enum, like LogRecord.level: a stored row may predate
  /// a kind OpenTelemetry has not defined yet.
  kind          String  @db.VarChar(16)
  /// "unset" | "ok" | "error".
  statusCode    String  @db.VarChar(5)
  statusMessage String? @db.VarChar(1024)

  /// Millisecond-truncated start: what listing, ordering, and retention need,
  /// and the only precision a JavaScript Date round-trips.
  startedAt           DateTime @db.Timestamptz(3)
  /// The same instant in the exact nanoseconds OTLP reported. A waterfall places
  /// sibling spans microseconds apart, which Timestamptz(3) cannot express. An
  /// `endedAt` is deliberately absent: it is start plus duration, and no query
  /// asks for it.
  startTimeUnixNano   BigInt
  durationNanoseconds BigInt
  receivedAt          DateTime @default(now()) @db.Timestamptz(3)

  /// Lifted out of the OTLP resource so a listing does not have to open JSON.
  serviceName  String  @db.VarChar(200)
  environment  String? @db.VarChar(100)
  release      String? @db.VarChar(200)
  scopeName    String? @db.VarChar(200)
  scopeVersion String? @db.VarChar(100)

  attributes         Json?
  resourceAttributes Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Idempotency and the waterfall read, in one index. OTLP carries no eventId,
  /// but a span is already identified by its trace and span ids, and an exporter
  /// retrying a batch re-sends identical spans. The leading (projectId, traceId)
  /// is exactly the lookup the trace view makes.
  @@unique([projectId, traceId, spanId])
  /// Listing recent traces reads only root spans. A btree serves
  /// `"parentSpanId" IS NULL` as well as an equality, so this does not need to
  /// be a partial index — which the Prisma schema could not express anyway.
  @@index([projectId, parentSpanId, startedAt(sort: Desc)])
  @@index([receivedAt(sort: Desc)])
}

model QueueMessage {
  id               String    @id @default(uuid()) @db.Uuid
  queue            String    @db.VarChar(200)
  payload          Json
  deduplicationKey String?   @db.VarChar(200)
  enqueuedAt       DateTime  @default(dbgenerated("date_trunc('milliseconds', CURRENT_TIMESTAMP)")) @db.Timestamptz(3)
  availableAt      DateTime  @default(dbgenerated("date_trunc('milliseconds', CURRENT_TIMESTAMP)")) @db.Timestamptz(3)
  attempt          Int       @default(0)
  claimedBy        String?   @db.VarChar(200)
  leaseToken       String?   @db.Uuid
  leaseExpiresAt   DateTime? @db.Timestamptz(3)
  lastError        String?

  @@unique([queue, deduplicationKey])
  @@index([queue, availableAt, leaseExpiresAt])
  @@index([leaseExpiresAt])
}
